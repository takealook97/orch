#!/bin/sh
# Fast checks on staged Go files: gofmt, build, vet. Tests run elsewhere.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
[ -z "$files" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
unformatted=$(echo "$files" | xargs gofmt -l)
if [ -n "$unformatted" ]; then
	echo "pre-commit: gofmt needed:" >&2
	echo "$unformatted" >&2
	exit 1
fi
go build ./... || { echo "pre-commit: go build failed" >&2; exit 1; }
go vet ./... || { echo "pre-commit: go vet failed" >&2; exit 1; }
