#!/bin/bash
# Fast checks on the staged Go content: gofmt, build, vet. Tests run elsewhere.
# Everything is read from the index, so unstaged edits cannot hide or fake a result.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

tmp=$(mktemp -d)
trap '[ -n "${tmp:-}" ] && rm -r -- "$tmp"' EXIT

# Take the staged list once and check git's exit status before reading it.
list="$tmp/staged.list"
if ! git diff --cached --name-status -z >"$list"; then
	echo "pre-commit: git diff --cached failed" >&2
	exit 1
fi

# Any .go path that is added, changed, deleted, or renamed to or from .go needs build/vet.
# gofmt only checks .go files that stay in the index.
need_build=0
fmt_paths=()
status=""
while IFS= read -r -d '' field; do
	if [ -z "$status" ]; then
		status=$field
		case "$status" in
		R* | C*) left=2 ;;
		*) left=1 ;;
		esac
		continue
	fi
	left=$((left - 1))
	case "$field" in
	*.go)
		need_build=1
		if [ "$left" -eq 0 ] && [ "${status:0:1}" != "D" ]; then
			fmt_paths+=("$field")
		fi
		;;
	esac
	[ "$left" -eq 0 ] && status=""
done <"$list"
[ "$need_build" -eq 0 ] && exit 0

failed=""
for path in ${fmt_paths[@]+"${fmt_paths[@]}"}; do
	staged="$tmp/staged.go"
	git show ":$path" >"$staged"
	if ! out=$(gofmt -l "$staged" 2>&1); then
		failed="$failed$path: $out"$'\n'
	elif [ -n "$out" ]; then
		failed="$failed$path"$'\n'
	fi
done

if [ -n "$failed" ]; then
	echo "pre-commit: gofmt needed:" >&2
	printf '%s' "$failed" >&2
	exit 1
fi

snap="$tmp/snapshot"
mkdir "$snap"
git checkout-index -a --prefix="$snap/"
cd "$snap"
go build ./... || { echo "pre-commit: go build failed" >&2; exit 1; }
go vet ./... || { echo "pre-commit: go vet failed" >&2; exit 1; }
